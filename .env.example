# Connect to Postgres via connection pooling (Neon).
DATABASE_URL=

# Direct connection to the database. Used for migrations.
DIRECT_URL=

# Vercel Blob read/write token (from Vercel Dashboard → Storage → Blob)
BLOB_READ_WRITE_TOKEN=

# Secret key for Better Auth session signing (openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Public URL of the app (used by Better Auth for redirects)
BETTER_AUTH_URL=
